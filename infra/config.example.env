# Settings for the infra scripts. Copy to infra/config.env (git-ignored, never committed) and adjust.
# The secrets at the end stay in your config.env; scripts/set-secrets.sh copies them into Secrets
# Manager (the secrets stack), where the backend reads them. The database and token secrets are
# generated by CloudFormation.

# AWS CLI profile and region. Learner Lab: fill the profile from "AWS Details" each session.
AWS_PROFILE=siit-lab
AWS_REGION=us-east-1

# Prefix of every name (stacks, roles, cluster, repositories, log groups). In an account shared
# with other teams use your group's prefix: the scripts only touch names that start with it.
# 3-20 lowercase letters, digits or hyphens.
PROJECT=siit

# The delegated subdomain (D29). The portal is APP_HOST.ZONE_NAME; CloudFront reaches the ALB at
# ORIGIN_HOST.ZONE_NAME.
ZONE_NAME=portal.example.org
APP_HOST=app
ORIGIN_HOST=origin

# cloudfront: CloudFront + S3 in front of the ALB (the target design).
# direct: the ALB is the public entry and there is no edge stack (accounts without CloudFront,
# e.g. AWS Learner Lab).
ENTRY_MODE=cloudfront
# false: no dns/cert stacks; the ALB answers over HTTP on its AWS name (smoke tests only: the
# sign-in cookie needs HTTPS).
USE_DOMAIN=true

# The stacks create their own least-privilege IAM roles (<PROJECT>-<service>-exec/-task).

# Where the database runs (D31): ecs = MySQL as an ECS task on EFS (budget, the data stack);
# rds = RDS MySQL Multi-AZ (the rds stack: private subnets, TLS checked, backups). To move a running
# portal with its data: set rds here, then run switch-to-rds.sh (deploy.sh data alone creates an
# empty RDS database).
DATA_MODE=ecs
# rds only: instance class, the standby in the second AZ (false = single AZ, cheaper), and the days
# of automated backups (point-in-time restore; kept after a delete until they expire)
DB_INSTANCE_CLASS=db.t3.micro
DB_MULTI_AZ=true
DB_BACKUP_DAYS=7
# Deleting the rds stack (teardown) takes a final snapshot. When the stack is created again it
# starts from: latest = the newest such snapshot (default), none = an empty database, or a
# snapshot name. Old snapshots stay until you delete them (about USD 0.1 per GB-month).
DB_RESTORE=latest

# Task counts set by deploy.sh (pause.sh and resume.sh change them without a deploy)
BACKEND_DESIRED_COUNT=1
# ecs data mode only (the MySQL task)
DB_DESIRED_COUNT=1
# direct mode only (web stack: nginx with the React build behind the ALB)
FRONTEND_DESIRED_COUNT=1
# Grafana at /grafana/ (grafana stack): 1 or 0 (paused)
GRAFANA_DESIRED_COUNT=1
# Who may sign in to Grafana with Google (Viewer): exact addresses, comma-separated, e.g.
# staff1@siit.tu.ac.th,m1234567890@g.siit.tu.ac.th (no whole domains). Empty = Google sign-in off,
# admin only. The portal role (Approver) doesn't count here: Grafana only sees the Google address.
GRAFANA_ALLOWED_EMAILS=
# Monitoring: per-task metrics in CloudWatch (billed per metric). Turn on for demo days only, then
# deploy.sh platform; back to disabled afterwards.
CONTAINER_INSIGHTS=disabled
# Logs (logs stack): days CloudWatch Logs keeps the service logs, the audit trail (at least one
# academic year, NFR-7.1) and the ALB access log files in S3. Allowed CloudWatch values: 1, 3, 5,
# 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731 (audit: 365 or more).
APP_LOG_DAYS=90
AUDIT_LOG_DAYS=400
ALB_LOG_DAYS=400
# Alarms are mailed here (empty = no email). AWS first sends a confirmation link to click.
ALERT_EMAIL=

# Who may sign in (D25) and the sign-in timeouts (FR-1.4), as in the root .env
STUDENT_EMAIL_DOMAIN=g.siit.tu.ac.th
STUDENT_ID_DIGITS=10
DEGREE_EMAIL_PREFIXES='{"UNDERGRADUATE":"","MASTER":"m","DOCTORAL":"d"}'
STAFF_EMAIL_DOMAINS=siit.tu.ac.th
# The approvers: exact addresses, comma-separated (no whole domains), e.g. staff1@siit.tu.ac.th.
# When set, being on it is the only way to be an approver (checked on every request; removing an
# address takes effect at once). Staff not on it sign in as requesters with a staff profile.
# Empty: approvers are set by hand (run-task.sh --identity node scripts/set-user-role.js ...).
APPROVER_EMAILS=
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Automatic provisioning of GPU requests through acc-prov-vm (queues stack). The values are as
# in the root .env; the backend's own message key is generated in AWS (queues stack output
# BackendPublicKey goes into acc-prov-vm's .env as MSG_PEER_PUBLIC_KEYS).
PROVISIONING=false
# acc-prov-vm's public key bundle as text: leave empty, set-site-key.sh puts it into SSM (the
# smoke test sets its own throwaway one)
SITE_PUBLIC_KEYS=
# Where site-ca.sh keeps the site CA (default ~/.siit-site-ca/<PROJECT>; outside the repository)
SITE_CA_DIR=
GPU_NODES=
OVPN_PROFILE_URL=
MANUAL_GPU_URL=
MANUAL_BIGDATA_URL=
MSG_JOB_TTL_SEC=259200
# Change to make a new backend key pair
MESSAGE_KEY_GENERATION=1
# Site health: alarm when no heartbeat came from acc-prov-vm for this many minutes (it sends one
# every 5; 0 = no alarm), and when jobs wait this many minutes with none taken by the site
SITE_HEARTBEAT_MINUTES=15
SITE_QUEUE_WAIT_MINUTES=5

# Scheduler: seconds between passes, reminder days before the end date (0 = none), and the time
# zone request dates are in
SCHEDULER_INTERVAL_SEC=300
EXPIRY_REMINDER_DAYS=3
SITE_TIME_ZONE=Asia/Bangkok

# Shown on the Contact Us page (baked into the frontend build: the S3 upload or the frontend image)
CONTACT_EMAIL=

# How to run docker. From Git Bash on Windows with Docker in WSL:
#   DOCKER="wsl.exe -d Ubuntu-24.04 -- docker"
DOCKER=docker

# ---- Secrets: set-secrets.sh copies these into Secrets Manager (deploy.sh secrets first) ------
# They never go into a stack parameter, a command line or a log; the other scripts don't pass
# them on to the programs they run. This file is read by bash: put a value with spaces or any of
# < > & ; $ ' " ` in single quotes (a single quote inside one is written '\'').
# Google OAuth client (Google Cloud console, OAuth client of type Web application). Its
# authorized redirect URI is https://APP_HOST.ZONE_NAME/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Status emails (S2), as in the root .env. Leave SMTP_HOST empty to only log them. Gmail needs
# 2-Step Verification and an App Password; use an SIIT sender for production.
# SMTP_SECURE=true: TLS from the start (465); false: STARTTLS required (587).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM='SIIT ICT Server <CHANGE_ME>'
MAIL_REPLY_TO=
