# Settings for the infra scripts. Copy to infra/config.env (git-ignored, never committed) and adjust.
# The secrets at the end stay in your config.env; scripts/set-secrets.sh copies them into Secrets
# Manager (the secrets stack), where the backend reads them. The database and token secrets are
# generated by CloudFormation.

# AWS CLI profile and region. Learner Lab: fill the profile from "AWS Details" each session.
AWS_PROFILE=siit-lab
AWS_REGION=us-east-1

# Prefix for stack, cluster and repository names
PROJECT=siit

# The delegated subdomain (D29). The portal is APP_HOST.ZONE_NAME; CloudFront reaches the ALB at
# ORIGIN_HOST.ZONE_NAME.
ZONE_NAME=portal.example.org
APP_HOST=app
ORIGIN_HOST=origin

# cloudfront: CloudFront + S3 in front of the ALB (the target design).
# direct: the ALB is the public entry and there is no edge stack (accounts without CloudFront,
# e.g. AWS Learner Lab).
ENTRY_MODE=cloudfront
# false: no dns/cert stacks; the ALB answers over HTTP on its AWS name (smoke tests only: the
# sign-in cookie needs HTTPS).
USE_DOMAIN=true

# IAM role for the ECS task and execution roles. Learner Lab: LabRole (D30).
ROLE_NAME=LabRole

# Task counts set by deploy.sh (pause.sh and resume.sh change them without a deploy)
BACKEND_DESIRED_COUNT=1
DB_DESIRED_COUNT=1
# direct mode only (web stack: nginx with the React build behind the ALB)
FRONTEND_DESIRED_COUNT=1

# Who may sign in (D25) and the sign-in timeouts (FR-1.4), as in the root .env
STUDENT_EMAIL_DOMAIN=g.siit.tu.ac.th
STUDENT_ID_DIGITS=10
DEGREE_EMAIL_PREFIXES='{"UNDERGRADUATE":"","MASTER":"m","DOCTORAL":"d"}'
STAFF_EMAIL_DOMAINS=siit.tu.ac.th
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Automatic provisioning of GPU requests through acc-prov-vm (queues stack). The values are as
# in the root .env; the backend's own message key is generated in AWS (queues stack output
# BackendPublicKey goes into acc-prov-vm's .env as MSG_PEER_PUBLIC_KEYS).
PROVISIONING=false
# acc-prov-vm's public key bundle (npm run keygen there); public, not secret
SITE_PUBLIC_KEYS=
GPU_NODES=
OVPN_PROFILE_URL=
MANUAL_GPU_URL=
MSG_JOB_TTL_SEC=259200
# Change to make a new backend key pair
MESSAGE_KEY_GENERATION=1

# Scheduler: seconds between passes, reminder days before the end date (0 = none), and the time
# zone request dates are in
SCHEDULER_INTERVAL_SEC=300
EXPIRY_REMINDER_DAYS=3
SITE_TIME_ZONE=Asia/Bangkok

# Shown on the Contact Us page (baked into the frontend build: the S3 upload or the frontend image)
CONTACT_EMAIL=

# How to run docker. From Git Bash on Windows with Docker in WSL:
#   DOCKER="wsl.exe -d Ubuntu-24.04 -- docker"
DOCKER=docker

# ---- Secrets: set-secrets.sh copies these into Secrets Manager (deploy.sh secrets first) ------
# They never go into a stack parameter, a command line or a log; the other scripts don't pass
# them on to the programs they run. This file is read by bash: put a value with spaces or any of
# < > & ; $ ' " ` in single quotes (a single quote inside one is written '\'').
# Google OAuth client (Google Cloud console, OAuth client of type Web application). Its
# authorized redirect URI is https://APP_HOST.ZONE_NAME/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Status emails (S2), as in the root .env. Leave SMTP_HOST empty to only log them. Gmail needs
# 2-Step Verification and an App Password; use an SIIT sender for production.
# SMTP_SECURE=true: TLS from the start (465); false: STARTTLS required (587).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM='SIIT ICT Server <CHANGE_ME>'
MAIL_REPLY_TO=
