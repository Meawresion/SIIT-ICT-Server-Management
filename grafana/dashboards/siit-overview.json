          "expression": "fields @timestamp, @log, @message | filter level = \"error\" | sort @timestamp desc | limit 50",
          "statsGroups": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
