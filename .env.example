# The only env file for the docker compose stack (D24). Copy it to .env and fill in the values.
# Never commit .env. docker-compose.yml gives each container only its own keys.

# ---- mysql -------------------------------------------------------------------------------
# root is the admin user (schema, init.sql). The backend connects as MYSQL_USER, which the
# mysql image creates on the first start (empty volume) with rights on MYSQL_DATABASE only.
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=siit_resource
MYSQL_USER=siit_app
MYSQL_PASSWORD=CHANGE_ME

# ---- backend -----------------------------------------------------------------------------
NODE_ENV=development

# Google OAuth - get these from Google Cloud Console (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Signs the sign-in token. A long random value (at least 32 characters in production),
# e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME
# Sign-in ends after this many minutes without activity, and this many hours after sign-in
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

FRONTEND_URL=http://localhost:5173

# Who may sign in (D25). Students: <prefix><ID>@STUDENT_EMAIL_DOMAIN, where the prefix gives the
# degree; staff: <name>@one of STAFF_EMAIL_DOMAINS. Every other Google account is refused.
STUDENT_EMAIL_DOMAIN=g.siit.tu.ac.th
STUDENT_ID_DIGITS=10
DEGREE_EMAIL_PREFIXES='{"UNDERGRADUATE":"","MASTER":"m","DOCTORAL":"d"}'
STAFF_EMAIL_DOMAINS=siit.tu.ac.th

# Automatic provisioning of GPU requests through acc-prov-vm (plan §2). Leave MESSAGE_TRANSPORT
# empty to keep it off: approvers then mark GPU requests active by hand, like the other types.
# amqp = the local activemq service below (the backend signs in with ARTEMIS_USER/PASSWORD).
MESSAGE_TRANSPORT=
# The same queue names as in acc-prov-vm/.env
AMQP_REQUEST_QUEUE=provision-requests
AMQP_RESULT_QUEUE=provision-results
# The broker's dead-letter queue (Artemis: DLQ). The scheduler reads it and fails the jobs found
# there, so the approvers hear about them (FR-6.7). Leave empty to skip.
AMQP_DEAD_LETTER_QUEUE=DLQ
# Message keys (D22), a local set only, never reused on AWS: run "npm run keygen -- backend-local"
# in acc-prov-vm. Its MSG_PRIVATE_KEY value goes here; its public bundle goes into
# MSG_PEER_PUBLIC_KEYS in acc-prov-vm/.env. MSG_PEER_PUBLIC_KEYS here is acc-prov-vm's public bundle.
MSG_PRIVATE_KEY=
MSG_PEER_PUBLIC_KEYS=
# How long a job stays valid (so it survives the site being offline), and the longest lifetime
# accepted on a result; keep MSG_JOB_TTL_SEC <= MSG_MAX_TTL_SEC in acc-prov-vm/.env.
MSG_JOB_TTL_SEC=259200
MSG_MAX_TTL_SEC=259200
# GPU node names as in acc-prov-vm's gpu-nodes.json, comma-separated; a tie in load goes to the first
GPU_NODES=CHANGE_ME
# Links acc-prov-vm puts in the student's email (shared .ovpn profile, GPU and Big Data manuals)
OVPN_PROFILE_URL=https://example.com/CHANGE_ME-ovpn-profile
MANUAL_GPU_URL=https://example.com/CHANGE_ME-gpu-manual
MANUAL_BIGDATA_URL=https://example.com/CHANGE_ME-bigdata-manual

# Status emails to students and approvers (FR-4.3; login details still come from acc-prov-vm).
# Leave SMTP_HOST empty to only log them. Recipients are limited to STUDENT_EMAIL_DOMAIN and
# STAFF_EMAIL_DOMAINS. Gmail needs 2-Step Verification and an App Password; use an SIIT sender
# for production. SMTP_SECURE=true: TLS from the start (465); false: STARTTLS required (587).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=CHANGE_ME
SMTP_APP_PASSWORD=
MAIL_FROM=SIIT ICT Server <CHANGE_ME>
MAIL_REPLY_TO=

# Scheduler (FR-8.2, FR-8.4): end-date reminders, turning off ended requests, dead letters.
# Seconds between passes; the reminder goes out this many days before the end date (0 = none);
# request dates are days in SITE_TIME_ZONE.
SCHEDULER_INTERVAL_SEC=300
EXPIRY_REMINDER_DAYS=3
SITE_TIME_ZONE=Asia/Bangkok

# ---- frontend (VITE_* values reach the browser; never put secrets here) -------------------
# Backend base URL. Empty means the same origin as the page (AWS: CloudFront serves /api/*).
VITE_API_URL=http://localhost:3000
# Shown on the Contact Us page
VITE_CONTACT_EMAIL=

# ---- activemq (local message broker, D23) -------------------------------------------------
# Use a long random password.
ARTEMIS_USER=CHANGE_ME
ARTEMIS_PASSWORD=CHANGE_ME
