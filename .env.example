# Docker Compose Environment Variables
# IMPORTANT: DO NOT COMMIT THIS FILE TO GIT!
# Copy from .env.example and fill in your actual values

# Database
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=siit_resource
DATABASE_URL=mysql://root:password@mysql:3306/siit_resource

# Google OAuth - Get from Google Cloud Console
# https://console.cloud.google.com/
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Session & Security
SESSION_SECRET=dev-secret-please-change-in-production

# Who may sign in (D25). Students: <prefix><ID>@STUDENT_EMAIL_DOMAIN, where the prefix gives the
# degree; staff: <name>@one of STAFF_EMAIL_DOMAINS. Every other Google account is refused.
STUDENT_EMAIL_DOMAIN=g.siit.tu.ac.th
STUDENT_ID_DIGITS=10
DEGREE_EMAIL_PREFIXES='{"UNDERGRADUATE":"","MASTER":"m","DOCTORAL":"d"}'
STAFF_EMAIL_DOMAINS=siit.tu.ac.th

# URLs
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Node Environment
NODE_ENV=development

# Local message broker (ActiveMQ Artemis, D23). Use a long random password.
ARTEMIS_USER=CHANGE_ME
ARTEMIS_PASSWORD=CHANGE_ME
