# The only env file for the docker compose stack (D24). Copy it to .env and fill in the values.
# Never commit .env. docker-compose.yml gives each container only its own keys.

# ---- mysql -------------------------------------------------------------------------------
# root is the admin user (schema, init.sql). The backend connects as MYSQL_USER, which the
# mysql image creates on the first start (empty volume) with rights on MYSQL_DATABASE only.
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=siit_resource
MYSQL_USER=siit_app
MYSQL_PASSWORD=CHANGE_ME

# ---- backend -----------------------------------------------------------------------------
NODE_ENV=development

# Google OAuth - get these from Google Cloud Console (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Signs the sign-in token. A long random value (at least 32 characters in production),
# e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME
# Sign-in ends after this many minutes without activity, and this many hours after sign-in
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

FRONTEND_URL=http://localhost:5173

# Who may sign in (D25). Students: <prefix><ID>@STUDENT_EMAIL_DOMAIN, where the prefix gives the
# degree; staff: <name>@one of STAFF_EMAIL_DOMAINS. Every other Google account is refused.
STUDENT_EMAIL_DOMAIN=g.siit.tu.ac.th
STUDENT_ID_DIGITS=10
DEGREE_EMAIL_PREFIXES='{"UNDERGRADUATE":"","MASTER":"m","DOCTORAL":"d"}'
STAFF_EMAIL_DOMAINS=siit.tu.ac.th

# ---- frontend (VITE_* values reach the browser; never put secrets here) -------------------
# Backend base URL. Empty means the same origin as the page (AWS: CloudFront serves /api/*).
VITE_API_URL=http://localhost:3000
# Shown on the Contact Us page
VITE_CONTACT_EMAIL=

# ---- activemq (local message broker, D23) -------------------------------------------------
# Use a long random password.
ARTEMIS_USER=CHANGE_ME
ARTEMIS_PASSWORD=CHANGE_ME
