# Backend base URL
VITE_API_URL=http://localhost:3000

# Shown on the Contact Us page
VITE_CONTACT_EMAIL=

# Local UI preview only. Mock auth is ignored by production builds.
# Set true to open protected routes as a demo student; use reviewer to preview admin pages.
VITE_MOCK_AUTH=false
VITE_MOCK_AUTH_ROLE=student
