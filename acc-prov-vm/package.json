{
  "name": "acc-prov-vm",
  "version": "0.1.0",
  "private": true,
  "description": "Account Provisioning VM: creates and revokes student VPN (pfSense), Linux and HUE accounts at the SIIT resource site",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env src/main.js",
    "test": "node --test test/*.unit.test.js",
    "test:pfsense": "node --env-file=.env --test --test-concurrency=1 test/pfsense.integration.test.js",
    "test:gpu": "node --env-file=.env --test --test-concurrency=1 --test-timeout=1800000 test/gpu.integration.test.js",
    "test:mail": "node --env-file=.env --test --test-concurrency=1 test/mail.integration.test.js",
    "test:amqp": "node --env-file=.env --test --test-concurrency=1 test/amqp.integration.test.js",
    "test:worker-broker": "node --env-file=.env --test --test-concurrency=1 test/worker.broker.integration.test.js",
    "keygen": "node scripts/keygen.js",
    "check:config": "node --env-file=.env -e \"import('./src/config.js').then((c) => { c.loadPfSenseConfig(); const g = c.loadGpuConfig(); console.log('config OK; GPU nodes:', g.nodes.map((n) => n.name + '=' + n.host).join(', ')); })\"",
    "send-test-job": "node --env-file=.env scripts/send-test-job.js"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1151.0",
    "nodemailer": "10.0.16",
    "playwright": "1.64.1",
    "rhea": "3.0.5",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
