# Copy to .env (git-ignored) on the acc-prov-vm host. Never commit real values.
# Wrap any value containing # in single quotes: an unquoted # starts a comment, so
# PFSENSE_PASSWORD=ab#cd is read as "ab". Write PFSENSE_PASSWORD='ab#cd'.
# Nothing site-specific has a default in code: every value below must be set.

# pfSense webGUI (System > User Manager)
PFSENSE_URL=https://192.0.2.1:8443
PFSENSE_USER=CHANGE_ME
PFSENSE_PASSWORD=
# Exact CA name as listed in System > Certificates > Authorities
PFSENSE_CA_NAME=CHANGE_ME
# User certificate (values from the technician manual)
PFSENSE_CERT_KEY_TYPE=RSA
PFSENSE_CERT_KEY_LENGTH=2048
PFSENSE_CERT_DIGEST=sha256
PFSENSE_CERT_LIFETIME_DAYS=3650

# GPU nodes: the node list (name, IP, port, host-key fingerprints, Jupyter URL, conda) is in
# a settings file. Copy gpu-nodes.example.json to gpu-nodes.json (git-ignored) and edit it.
# Adding a node = adding an entry there.
GPU_NODES_FILE=gpu-nodes.json
# SSH login for all GPU nodes. Phase 1 (D18): an admin account with a password; sudo uses the same one.
GPU_SSH_USER=CHANGE_ME
GPU_SSH_PASSWORD=
# GPU_SSH_KEY_PATH=C:\Users\<you>\.ssh\id_ed25519   (use instead of GPU_SSH_PASSWORD)
# GPU_SUDO_PASSWORD=                                 (defaults to GPU_SSH_PASSWORD)
# Per-node overrides: append the node name in upper case with - as _, e.g. for "gpu-02":
# GPU_SSH_USER_GPU_02=  GPU_SSH_PASSWORD_GPU_02=  GPU_SSH_KEY_PATH_GPU_02=  GPU_SUDO_PASSWORD_GPU_02=

# Student email (D9, temporary): Gmail SMTP needs 2-Step Verification + an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true = TLS from the start (port 465); false = STARTTLS, required (port 587)
SMTP_SECURE=true
SMTP_USER=CHANGE_ME@gmail.com
SMTP_APP_PASSWORD=
MAIL_FROM=SIIT ICT Server <CHANGE_ME@gmail.com>
# MAIL_REPLY_TO=
# Comma-separated; if set, emails only go to these domains (recommended: the SIIT student domain)
MAIL_ALLOWED_RECIPIENT_DOMAINS=

# Local message broker (D23): the ActiveMQ Artemis container from the root docker-compose.yml.
# Same user/password as ARTEMIS_USER / ARTEMIS_PASSWORD in the root .env.
AMQP_URL=amqp://127.0.0.1:5672
AMQP_USER=CHANGE_ME
AMQP_PASSWORD=
AMQP_REQUEST_QUEUE=provision-requests
AMQP_RESULT_QUEUE=provision-results

# Message keys (D22). Generate this side's bundle with: npm run keygen -- site-YYYY-MM
# Private bundle of THIS side (never leaves this host):
MSG_PRIVATE_KEY=
# Public bundle(s) of the backend, comma-separated during a key rotation (first = current).
# AWS: the queues stack output BackendPublicKey.
MSG_PEER_PUBLIC_KEYS=
# Accept jobs whose lifetime (exp - iat) is at most this many seconds
MSG_MAX_TTL_SEC=259200
# Lifetime of the result messages this side sends
MSG_RESULT_TTL_SEC=86400

# AWS (MESSAGE_TRANSPORT=sqs): the queue URLs from the queues stack outputs (RequestQueueUrl,
# ResultQueueUrl). Learner Lab: paste the session's AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and
# AWS_SESSION_TOKEN here each session (they expire after a few hours).
AWS_REGION=us-east-1
SQS_REQUEST_QUEUE_URL=
SQS_RESULT_QUEUE_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Worker (npm start). amqp = the local ActiveMQ above; sqs = AWS
MESSAGE_TRANSPORT=amqp
# Attempts per job before a failed result is sent; keep it below the broker's max delivery
# attempts (Artemis default 10; SQS: the queues stack MaxReceiveCount, 5), so the backend always
# gets an answer instead of a silent DLQ
WORKER_MAX_ATTEMPTS=3
# Handled jobs (jti -> result), no secrets; data/ is git-ignored
JOB_STORE_FILE=data/jobs.json
PASSWORD_LENGTH=16
# false until the full integration test: the pfSense step is skipped and emails tell the
# student to keep their existing VPN password
PFSENSE_ENABLED=false

# Set to false to watch the browser while debugging
HEADLESS=true

# ---- Integration tests only ----
# Throwaway account password (the test user is st9990000001)
TEST_PASSWORD=
# GPU node name (from gpu-nodes.json) used by the GPU integration test
GPU_TEST_NODE=gpu-01
# pfSense live tests are skipped unless this is 1 (they create real accounts)
RUN_PFSENSE_TESTS=0
# send-test-job (local only, plays the backend): a backend TEST bundle and this site's public bundle
# npm run keygen -- backend-local   -> its MSG_PRIVATE_KEY value goes here; its public -> MSG_PEER_PUBLIC_KEYS
TEST_BACKEND_PRIVATE_KEY=
TEST_SITE_PUBLIC_KEY=
# The links a test job puts in the email (in production the backend sends them, from its config).
# Required by "send-test-job create"; optional for the mail test.
OVPN_PROFILE_URL=https://example.com/CHANGE_ME-ovpn-profile
MANUAL_GPU_URL=https://example.com/CHANGE_ME-gpu-manual
# Mail test: where the sample email goes; optional extra service link to check in it
MAIL_TEST_TO=
# MAIL_TEST_SERVICE_URL=
