NODE_ENV=development
PORT=3000

DATABASE_URL=mysql://root:password@mysql:3306/siit_resource

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

SESSION_SECRET=dev-secret-please-change-in-production

# Who may sign in (D25). Students: <prefix><ID>@STUDENT_EMAIL_DOMAIN, where the prefix gives the
# degree; staff: <name>@one of STAFF_EMAIL_DOMAINS. Every other Google account is refused.
STUDENT_EMAIL_DOMAIN=g.siit.tu.ac.th
STUDENT_ID_DIGITS=10
DEGREE_EMAIL_PREFIXES='{"UNDERGRADUATE":"","MASTER":"m","DOCTORAL":"d"}'
STAFF_EMAIL_DOMAINS=siit.tu.ac.th

FRONTEND_URL=http://localhost:5173
