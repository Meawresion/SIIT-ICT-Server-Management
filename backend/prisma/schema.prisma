generator client {
  provider      = "prisma-client-js"
  // native: the developer's machine; linux-musl-openssl-3.0.x: the Alpine backend image.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model draft {
  student_uid   Int                  @id @db.UnsignedInt
  resource_type draft_resource_type?
  por           String?              @db.VarChar(255)
  proj_name     String?              @db.VarChar(255)
  spv_name      String?              @db.VarChar(100)
  spv_email     String?              @db.VarChar(100)
  justify       String?              @db.Text
  start_date    DateTime?            @db.DateTime(0)
  end_date      DateTime?            @db.DateTime(0)
  extra_details Json?
  updated_at    DateTime             @default(now()) @updatedAt @db.Timestamp(0)
  user          user                 @relation(fields: [student_uid], references: [uid], onDelete: Cascade, onUpdate: Restrict, map: "draft_student_uid_foreign")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model request {
  rid                             Int                   @id @default(autoincrement()) @db.UnsignedInt
  student_uid                     Int                   @db.UnsignedInt
  resource_type                   request_resource_type
  por                             String                @db.VarChar(255)
  proj_name                       String                @db.VarChar(255)
  spv_name                        String                @db.VarChar(100)
  spv_email                       String                @db.VarChar(100)
  justify                         String                @db.Text
  start_date                      DateTime              @db.DateTime(0)
  end_date                        DateTime              @db.DateTime(0)
  extra_details                   Json?
  process_type                    request_process_type  @default(Manual)
  status                          request_status        @default(Pending)
  approver_uid                    Int?                  @db.UnsignedInt
  reviewed_at                     DateTime?             @db.Timestamp(0)
  created_at                      DateTime              @default(now()) @db.Timestamp(0)
  updated_at                      DateTime              @default(now()) @updatedAt @db.Timestamp(0)
  user_request_approver_uidTouser user?                 @relation("request_approver_uidTouser", fields: [approver_uid], references: [uid], onDelete: Restrict, onUpdate: Restrict, map: "request_approver_uid_foreign")
  user_request_student_uidTouser  user                  @relation("request_student_uidTouser", fields: [student_uid], references: [uid], onUpdate: Restrict, map: "request_student_uid_foreign")

  @@index([approver_uid], map: "request_approver_uid_foreign")
  @@index([student_uid], map: "request_student_uid_foreign")
}

model user {
  uid                                Int                @id @default(autoincrement()) @db.UnsignedInt
  role                               user_role
  fullname                           String             @db.VarChar(100)
  siitemail                          String             @unique(map: "user_siitemail_unique") @db.VarChar(100)
  phone_number                       String             @db.VarChar(15)
  s_id                               String?            @db.VarChar(12)
  study_degree                       user_study_degree?
  s_program                          String?            @db.VarChar(50)
  advisor_name                       String?            @db.VarChar(100)
  created_at                         DateTime           @default(now()) @db.Timestamp(0)
  updated_at                         DateTime           @default(now()) @updatedAt @db.Timestamp(0)
  draft                              draft?
  request_request_approver_uidTouser request[]          @relation("request_approver_uidTouser")
  request_request_student_uidTouser  request[]          @relation("request_student_uidTouser")
}

enum draft_resource_type {
  GPU_SERVER
  BIG_DATA
  VM
  LAB_EQUIPMENT
  AWS_LAB
  AWS_SKILL
}

enum user_role {
  Approver
  Student
}

enum request_resource_type {
  GPU_SERVER
  BIG_DATA
  VM
  LAB_EQUIPMENT
  AWS_LAB
  AWS_SKILL
}

enum user_study_degree {
  Undergraduate
  Master
  PhD
}

enum request_process_type {
  Manual
  Automate
}

enum request_status {
  Pending
  Approved
  Rejected
  On_Use    @map("On Use")
  Completed
}
