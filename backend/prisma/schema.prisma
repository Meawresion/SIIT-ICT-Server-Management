generator client {
  provider      = "prisma-client-js"
  // native: the developer's machine; linux-musl-openssl-3.0.x: the Alpine backend image.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// An unfinished request (FR-3.2, FR-3.3): any field may still be empty. A student can keep several.
model draft {
  did                  Int                  @id @default(autoincrement()) @db.UnsignedInt
  student_uid          Int                  @db.UnsignedInt
  resource_type        draft_resource_type?
  por                  String?              @db.VarChar(255)
  proj_description     String?              @db.Text
  spv_name             String?              @db.VarChar(100)
  justify              String?              @db.Text
  tech_requirements    String?              @db.VarChar(2000)
  impact_score         Int?                 @db.UnsignedTinyInt
  supervisor_confirmed Boolean              @default(false)
  start_date           DateTime?            @db.Date
  end_date             DateTime?            @db.Date
  created_at           DateTime             @default(now()) @db.Timestamp(0)
  updated_at           DateTime             @default(now()) @updatedAt @db.Timestamp(0)
  user                 user                 @relation(fields: [student_uid], references: [uid], onDelete: Cascade, onUpdate: Restrict, map: "draft_student_uid_foreign")

  @@index([student_uid, updated_at], map: "draft_student_updated_index")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model request {
  rid                             Int                   @id @default(autoincrement()) @db.UnsignedInt
  student_uid                     Int                   @db.UnsignedInt
  resource_type                   request_resource_type
  por                             String                @db.VarChar(255)
  proj_description                String                @db.Text
  spv_name                        String                @db.VarChar(100)
  justify                         String                @db.Text
  tech_requirements               String                @default("") @db.VarChar(2000)
  impact_score                    Int                   @db.UnsignedTinyInt
  supervisor_confirmed            Boolean
  start_date                      DateTime              @db.DateTime(0)
  end_date                        DateTime              @db.DateTime(0)
  process_type                    request_process_type  @default(Manual)
  status                          request_status        @default(Pending)
  gpu_node                        String?               @db.VarChar(32)
  approver_uid                    Int?                  @db.UnsignedInt
  review_comment                  String?               @db.Text
  reviewed_at                     DateTime?             @db.Timestamp(0)
  created_at                      DateTime              @default(now()) @db.Timestamp(0)
  updated_at                      DateTime              @default(now()) @updatedAt @db.Timestamp(0)
  user_request_approver_uidTouser user?                 @relation("request_approver_uidTouser", fields: [approver_uid], references: [uid], onDelete: Restrict, onUpdate: Restrict, map: "request_approver_uid_foreign")
  user_request_student_uidTouser  user                  @relation("request_student_uidTouser", fields: [student_uid], references: [uid], onUpdate: Restrict, map: "request_student_uid_foreign")
  request_event                   request_event[]
  provision_job                   provision_job[]
  request_extension               request_extension[]

  @@index([approver_uid], map: "request_approver_uid_foreign")
  @@index([student_uid, created_at], map: "request_student_created_index")
  @@index([status, created_at], map: "request_status_created_index")
  @@index([created_at], map: "request_created_index")
}

/// FR-8.3: a student's ask for a later end date and the approver's decision. One Pending at a time.
model request_extension {
  xid            Int                      @id @default(autoincrement()) @db.UnsignedInt
  rid            Int                      @db.UnsignedInt
  end_date       DateTime                 @db.Date
  reason         String                   @db.VarChar(1000)
  status         request_extension_status @default(Pending)
  requested_at   DateTime                 @default(now()) @db.Timestamp(0)
  reviewer_uid   Int?                     @db.UnsignedInt
  review_comment String?                  @db.Text
  reviewed_at    DateTime?                @db.Timestamp(0)
  request        request                  @relation(fields: [rid], references: [rid], onDelete: Restrict, onUpdate: Restrict, map: "request_extension_rid_foreign")
  user           user?                    @relation(fields: [reviewer_uid], references: [uid], onDelete: Restrict, onUpdate: Restrict, map: "request_extension_reviewer_uid_foreign")

  @@index([rid, status], map: "request_extension_rid_index")
  @@index([reviewer_uid], map: "request_extension_reviewer_uid_foreign")
}

model user {
  uid                                Int                @id @default(autoincrement()) @db.UnsignedInt
  role                               user_role
  fullname                           String             @db.VarChar(100)
  siitemail                          String             @unique(map: "user_siitemail_unique") @db.VarChar(100)
  phone_number                       String             @db.VarChar(15)
  s_id                               String?            @db.VarChar(12)
  study_degree                       user_study_degree?
  s_program                          String?            @db.VarChar(50)
  advisor_name                       String?            @db.VarChar(100)
  created_at                         DateTime           @default(now()) @db.Timestamp(0)
  updated_at                         DateTime           @default(now()) @updatedAt @db.Timestamp(0)
  draft                              draft[]
  request_extension                  request_extension[]
  request_request_approver_uidTouser request[]          @relation("request_approver_uidTouser")
  request_request_student_uidTouser  request[]          @relation("request_student_uidTouser")
  request_event                      request_event[]
}

/// Append-only audit log (FR-9.1): the app's database user may only SELECT and INSERT.
/// actor_uid null = the system. Never update or delete rows (triggers refuse it).
model request_event {
  eid         BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  rid         Int                        @db.UnsignedInt
  action      String                     @db.VarChar(32)
  from_status request_event_from_status?
  to_status   request_event_to_status
  actor_uid   Int?                       @db.UnsignedInt
  comment     String?                    @db.Text
  details     Json?
  created_at  DateTime                   @default(now()) @db.Timestamp(0)
  request     request                    @relation(fields: [rid], references: [rid], onDelete: Restrict, onUpdate: Restrict, map: "request_event_rid_foreign")
  user        user?                      @relation(fields: [actor_uid], references: [uid], onDelete: Restrict, onUpdate: Restrict, map: "request_event_actor_uid_foreign")

  @@index([rid, eid], map: "request_event_rid_index")
  @@index([actor_uid], map: "request_event_actor_uid_foreign")
}

/// Outbox of jobs for acc-prov-vm (plan §2.1). A retry is a new row with a new job_id.
model provision_job {
  job_id          String               @id @db.Char(36)
  rid             Int                  @db.UnsignedInt
  action          provision_job_action
  status          provision_job_status @default(Queued)
  payload         Json
  attempts        Int                  @default(0) @db.UnsignedInt
  last_error      String?              @db.Text
  result          Json?
  next_attempt_at DateTime             @default(now()) @db.Timestamp(0)
  sent_at         DateTime?            @db.Timestamp(0)
  completed_at    DateTime?            @db.Timestamp(0)
  created_at      DateTime             @default(now()) @db.Timestamp(0)
  updated_at      DateTime             @default(now()) @updatedAt @db.Timestamp(0)
  request         request              @relation(fields: [rid], references: [rid], onDelete: Restrict, onUpdate: Restrict, map: "provision_job_rid_foreign")

  @@index([status, next_attempt_at], map: "provision_job_status_index")
  @@index([rid, created_at], map: "provision_job_rid_index")
}

model scheduler_lease {
  name        String   @id @db.VarChar(32)
  owner       String?  @db.VarChar(100)
  lease_until DateTime @db.DateTime(3)
}

model log_cursor {
  name       String   @id @db.VarChar(32)
  last_id    BigInt   @default(0) @db.UnsignedBigInt
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(0)
}

enum provision_job_action {
  CREATE
  REVOKE
  EXTEND
}

enum provision_job_status {
  Queued
  Sent
  Succeeded
  Failed
}

enum draft_resource_type {
  GPU_SERVER
  BIG_DATA
  VM
  LAB_EQUIPMENT
  AWS_LAB
  AWS_SKILL
}

enum request_extension_status {
  Pending
  Approved
  Rejected
}

enum user_role {
  Approver
  Student
}

enum request_resource_type {
  GPU_SERVER
  BIG_DATA
  VM
  LAB_EQUIPMENT
  AWS_LAB
  AWS_SKILL
}

enum user_study_degree {
  Undergraduate
  Master
  PhD
}

enum request_process_type {
  Manual
  Automate
}

enum request_status {
  Pending
  Approved
  Rejected
  On_Use    @map("On Use")
  Completed
}

enum request_event_from_status {
  Pending
  Approved
  Rejected
  On_Use    @map("On Use")
  Completed
}

enum request_event_to_status {
  Pending
  Approved
  Rejected
  On_Use    @map("On Use")
  Completed
}
